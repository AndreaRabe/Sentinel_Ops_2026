# --- Base de donnees ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sentinel_ops
DATABASE_URL=postgresql+asyncpg://sentinel:changeme@postgres:5432/sentinel_ops

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Securite ---
JWT_SECRET_KEY=changeme-generate-a-random-256-bit-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Seed / bootstrap ---
SEED_ADMIN_EMAIL=admin@sentinel-ops.local

# --- Frontend ---
VITE_API_BASE_URL=https://localhost:8000/api/v1

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://localhost:5173
