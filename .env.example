# --- Base de donnees ---
# PostgreSQL installe et lance en local (pas de Docker pour le moment).
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sentinel_ops
DATABASE_URL=postgresql+asyncpg://sentinel:changeme@localhost:5432/sentinel_ops

# --- Securite ---
JWT_SECRET_KEY=changeme-generate-a-random-256-bit-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie du refresh token : false en dev (HTTP simple). A mettre a true
# manuellement des que l'application tourne derriere du HTTPS.
COOKIE_SECURE=false

# Verrouillage brute-force du login. Le compteur est une fenetre glissante lue
# dans audit_logs (pas de Redis). Une connexion reussie remet le compteur a zero.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Documentation OpenAPI interactive (/docs, /redoc, /openapi.json).
# A passer a false des que l'application est exposee au-dela du poste de dev.
DOCS_ENABLED=true

# --- Seed / bootstrap ---
SEED_ADMIN_EMAIL=admin@sentinel-ops.local

# --- Pieces jointes ---
# Repertoire local de stockage des fichiers joints aux taches et incidents,
# relatif au repertoire d'ou est lance le backend. A sauvegarder AU MEME TITRE
# que la base : les metadonnees en base sans les fichiers ne valent rien.
ATTACHMENTS_DIR=storage/attachments

# --- Planification (APScheduler) ---
# Fuseau utilise par les jobs (detection des retards toutes les 15 min,
# generation des taches recurrentes chaque nuit a 2h).
SCHEDULER_TIMEZONE=Europe/Paris
# A mettre a false si le backend devait un jour tourner en plusieurs workers :
# sinon chaque worker executerait les jobs et dupliquerait les taches generees.
SCHEDULER_ENABLED=true

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
